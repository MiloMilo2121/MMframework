# ============================================================
# SalesMap Intelligence — Environment Variables
# Copy this file to .env.local and fill in your keys.
# ============================================================

# --- API Keys (required) ------------------------------------
OPENROUTER_API_KEY=sk-or-...
EXA_API_KEY=exa-...

# --- API Keys (optional) ------------------------------------
ANTHROPIC_API_KEY=sk-ant-...   # direct Anthropic SDK fallback (transcript-process)

# --- App ---------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================
# COGNITIVE ARBITRAGE — MODEL ROUTING HIERARCHY
# Three tiers: Miner (cheap) → Architect (reasoning) → Ghostwriter (prose)
# Do NOT assign a Miner model to the Ghostwriter slot or vice versa.
# ============================================================

# --- Tier 1: Miners (~$0.14-0.30/1M tokens) ----------------
# Role: HTML ingestion, Exa query generation, JSON/Memo extraction.
# NEVER writes final report prose. Prioritise speed and cost.
# Alternatives: google/gemini-2.5-flash
MINER_MODEL=deepseek/deepseek-chat

# --- Tier 2: Architect (~$0.55/1M tokens, reasoning) -------
# Role: Generates the dynamic chapter-index JSON (effort_tier-aware).
# Minimal token output, maximum structural reasoning.
# Alternatives: openai/o3-mini
ARCHITECT_MODEL=deepseek/deepseek-r1

# --- Tier 3: Ghostwriter (~$3/1M tokens) -------------------
# Role: ONLY model authorised to write final report prose.
# Receives pre-digested Miner memos via CoherenceGate.
# NEVER touches raw web data or Exa queries.
# Alternatives: anthropic/claude-3-5-sonnet-20241022
GHOSTWRITER_MODEL=anthropic/claude-sonnet-4-5

# Explicit aliases used by individual routes:
COHERENCE_MODEL=anthropic/claude-sonnet-4-5   # orchestrator CoherenceGate
STEP3_MODEL=anthropic/claude-sonnet-4-5       # conclusions

# ============================================================
# Per-step model overrides (optional — override defaults above)
# ============================================================
STEP0_MODEL=anthropic/claude-3-5-haiku-20241022   # web scouting (cheap)
STEP1_MODEL=anthropic/claude-opus-4-6             # strategic blueprint (Opus + thinking)
STEP2_MODEL=anthropic/claude-sonnet-4-5           # legacy part1/part2 routes
STEP2_PROVIDER=Anthropic
